// HanVui — mô hình dữ liệu (nguồn chuẩn nghiệp vụ: ../rule.md)
// Dùng Postgres thuần: không dùng Supabase Auth/Storage/RLS để chuyển VPS dễ.
// Ngày trong nghiệp vụ tính theo giờ Việt Nam (UTC+7), lưu dạng chuỗi "YYYY-MM-DD" / "YYYY-MM".

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum HskStandard {
  HSK2 // HSK 2.0 (6 cấp)
  HSK3 // HSK 3.0 (9 cấp)
}

enum TopicKind {
  VOCAB // chủ đề từ vựng (3.1)
  SITUATION // chủ đề tình huống của hội thoại (3.2)
}

enum LessonKind {
  DIALOG // bài học thường
  STORY // đoạn truyện sự kiện (bài học event)
  READING // bài đọc theo cấp (kỹ năng Đọc)
}

enum WritingType {
  ORDER // sắp xếp các phần thành câu
  FILL // điền chữ vào chỗ trống
  CHOOSE // chọn câu tiếng Trung đúng nghĩa
  WRONG // tìm câu sai ngữ pháp (options + answer = câu sai)
}

enum TokenKind {
  HINT // mở gợi ý (âm)
  ABSENCE // bù ngày vắng
  MONTH_END // ngày 26-28
  RESERVE // ngày dự trữ 29-31
  CATCHUP // gói theo kịp
  ADMIN // đền bù sự cố
  STARTER // lượt tặng khi tạo tài khoản (chỉ bản demo)
  MAIL // nhận quà từ hộp thư
  CODE // nhập mã quà (Tài khoản → Nhập mã)
}

enum MailSender {
  ADMIN // thư do quản trị gửi
  SYSTEM // thư tự động của hệ thống (chào mừng, trúng thưởng...)
}

enum MediaKind {
  AVATAR // ảnh đại diện người dùng
  LESSON_COVER // ảnh bối cảnh của hội thoại
  ROLE_AVATAR // ảnh nhân vật trong khung chat của hội thoại
}

enum ItemKind {
  VIP_3D // VIP 3 ngày (mốc 90%)
}

// ───────────── Tài khoản, đăng nhập ─────────────

model User {
  id             String      @id @default(uuid()) @db.Uuid
  email          String      @unique
  passwordHash   String
  displayName    String
  role           Role        @default(USER)
  hskStandard    HskStandard @default(HSK2)
  hskLevel       Int         @default(1) // cấp theo chuẩn đang chọn
  hoursLearned   Float       @default(0)
  vipUntil       DateTime? // VIP còn hiệu lực tới (không có tác dụng trong sự kiện)
  eventOptOut    Boolean     @default(false) // "Không tham gia sự kiện"
  practiceTokens Int         @default(0) // lượt gợi ý trong kho lưu trữ (nghe xong 2 bài mỗi ngày được 1)
  avatarId       String? // khóa gốc ảnh đại diện trên R2, ví dụ "img/avatars/<id>-ab12" (không lưu URL đầy đủ)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  refreshTokens RefreshToken[]
  lessonDone    UserLesson[]
  words         UserWord[]
  writing       WritingDone[]
  slots         UserSlot[]
  events        UserEvent[]
  missions      UserMission[]
  ledger        TokenLedger[]
  redeemUses    RedeemUse[]
  items         InventoryItem[]
  levelStats    UserLevelStat[]
  examAttempts  ExamAttempt[]
  vocabTests    VocabTest[]
  mails         UserMail[]
}

// Token làm mới: chỉ lưu mã băm, xoay vòng mỗi lần dùng (phát hiện bị đánh cắp).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  family    String    @db.Uuid // cùng một phiên đăng nhập
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

// Giờ học và số từ theo từng cấp (mục 2).
model UserLevelStat {
  userId   String      @db.Uuid
  standard HskStandard
  level    Int
  seconds  Int         @default(0)
  words    Int         @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, standard, level])
}

// ───────────── Nội dung học ─────────────

model Topic {
  id    String    @id // ví dụ "an-uong"
  kind  TopicKind
  name  String
  glyph String? // chữ đại diện, ví dụ "食"
  sort  Int       @default(0)

  words   Word[]
  lessons LessonTopic[]
  slots   KeySlot[]
}

model Word {
  id        Int     @id @default(autoincrement())
  topicId   String? // chủ đề từ vựng
  zh        String
  pinyin    String
  vi        String
  pos       String? // loại từ
  phrase    Boolean @default(false)
  hsk2      Int? // cấp HSK 2.0 (1-6)
  hsk2List  Int? // cấp trong DANH SÁCH từ HSK 2.0 (chỉ từ có đúng trong danh sách; hsk2 còn gán cho từ ghép suy ra). Dùng cho bộ kiểm tra từ vựng.
  hsk3      Int? // cấp HSK 3.0 (1-9)
  example   Json? // { zh, pinyin, vi }
  audioKey  String? // khóa file âm thanh của riêng từ trên R2 (audio/words/...)
  audioHash String? // băm chữ + giọng + nhà cung cấp; đổi thì sinh lại

  topic     Topic?     @relation(fields: [topicId], references: [id])
  userWords UserWord[]
  keySlots  KeySlot[]

  @@unique([zh, pinyin])
  @@index([topicId])
  @@index([zh])
}

model Lesson {
  id        String     @id // ví dụ "cafe", "cafe2"
  kind      LessonKind @default(DIALOG)
  title     String
  situation String // bối cảnh: nơi chốn, nhân vật (được tìm kiếm)
  tags      String[] // từ khóa bối cảnh (được tìm kiếm)
  level     Int // nhóm cấp của bài: 1 = HSK 1, 2 = HSK 2 (nút chọn cấp)
  twinId    String? // bài cùng chủ đề ở cấp kia
  hsk2      Int? // nhãn cấp HSK 2.0, tính tự động từ các từ trong bài
  hsk3      Int? // nhãn cấp HSK 3.0
  hskShown  Int? // cấp HSK 2.0 hiển thị: bằng `level`, chỉ cao hơn khi hơn 70% từ của bài thuộc cấp cao hơn (db:hsk)
  coverId   String? // khóa gốc ảnh bối cảnh trên R2
  published Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  topics    LessonTopic[]
  roles     LessonRole[]
  lines     LessonLine[]
  questions LessonQuestion[]
  done      UserLesson[]
  keySlots  KeySlotLesson[]
  storyHoi  Hoi[]

  @@index([kind, level])
}

model LessonTopic {
  lessonId String
  topicId  String
  sort     Int    @default(0) // 0 = chủ đề chính của bài (dùng cho biểu tượng), lớn hơn = chủ đề phụ

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
  @@index([topicId])
}

// Giọng nhân vật theo vai (3.2): giới tính + khoảng giọng.
model LessonRole {
  lessonId   String
  who        String // "A", "B", "N"...
  label      String // "Trưởng nhóm", "Lễ tân"...
  gender     String // "m" | "f"
  pitchRange Int // 1 trầm, 2 vừa, 3 cao
  voiceId    String? // ví dụ "zh-CN-YunjianNeural"
  avatarId   String? // khóa gốc ảnh nhân vật trên R2

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, who])
}

model LessonLine {
  lessonId  String
  idx       Int
  who       String
  zh        String
  pinyin    String
  vi        String
  tokens    Json // tách từ sẵn: [{ t, p?, v?, x? }] (x = dấu câu)
  audioKey  String? // khóa file trên Cloudflare R2 (không lưu URL đầy đủ)
  audioHash String? // băm nội dung + giọng; đổi thì sinh lại

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, idx])
}

// Câu hỏi bằng tiếng Trung kèm bản dịch.
model LessonQuestion {
  lessonId String
  idx      Int
  kind     String? // "Nghe hiểu", "Đoán chữ"
  prompt   String
  promptVi String
  options  Json // [{ zh, vi }]
  answer   Int // chỉ số đáp án đúng

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, idx])
}

// ───────────── Sự kiện truyện ─────────────

model Story {
  id       String    @id
  month    String    @unique // "2026-10": sự kiện chạy theo tháng dương lịch
  title    String
  titleZh  String?
  chapters Chapter[]
}

// Chương = 1 tuần (idx 1..4 = ngày 1-7, 8-14, 15-21, 22-28).
model Chapter {
  id      Int       @id @default(autoincrement())
  storyId String
  idx     Int
  title   String?
  story   Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  hoi     Hoi[]
  slots   KeySlot[]

  @@unique([storyId, idx])
}

// Hồi: mở khi tìm đủ 3, 6, 9, 12 ô của chương.
model Hoi {
  id            Int     @id @default(autoincrement())
  chapterId     Int
  idx           Int // 1..4
  title         String
  titleZh       String?
  storyLessonId String?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [storyLessonId], references: [id])

  @@unique([chapterId, idx])
}

// Ô từ khóa. Gợi ý dạng { zh, vi }; gợi ý 2, 3 theo nhóm cấp: { "1": {zh,vi}, "2": {...} }.
model KeySlot {
  id          Int     @id @default(autoincrement())
  chapterId   Int
  idx         Int // 1..12 (thứ tự gốc; mỗi người thấy một thứ tự xáo riêng)
  wordId      Int
  clueTopicId String? // chủ đề của gợi ý 1 (lọc danh sách bài)
  hintGeneral Json
  hint1       Json
  hint2       Json
  hint3       Json

  chapter   Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  word      Word            @relation(fields: [wordId], references: [id])
  clueTopic Topic?          @relation(fields: [clueTopicId], references: [id])
  lessons   KeySlotLesson[]
  users     UserSlot[]

  @@unique([chapterId, idx])
}

// Hội thoại chứa từ khóa, theo nhóm cấp (gợi ý 2 trỏ tới bài hợp cấp).
model KeySlotLesson {
  slotId   Int
  lessonId String
  hskGroup Int

  slot   KeySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([slotId, lessonId])
}

// ───────────── Tiến độ của người học ─────────────

model UserLesson {
  userId      String    @db.Uuid
  lessonId    String
  openedAt    DateTime  @default(now())
  answers     Json? // number[] lần trả lời gần nhất
  correct     Int       @default(0)
  allDone     Boolean   @default(false) // đã trả lời hết câu hỏi
  transcript  Boolean   @default(false) // đã mở lời thoại (trả lời xong hoặc bỏ qua)
  skippedDay  String? // ngày bấm "Bỏ qua, xem lời thoại" (bài không tính nhiệm vụ trong ngày đó)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// Sổ tay: một danh sách, nhiều cách xem (3.7). Từ chưa có trong từ điển vẫn lưu, AI điền nghĩa sau.
model UserWord {
  id             Int       @id @default(autoincrement())
  userId         String    @db.Uuid
  wordId         Int?
  zh             String
  pinyin         String    @default("")
  vi             String    @default("")
  pos            String?
  isPhrase       Boolean   @default(false)
  aiPending      Boolean   @default(false) // chờ AI điền nghĩa
  sourceLessonId String?
  topics         String[] // chủ đề của bài nguồn (tự lấy)
  hsk2           Int?
  hsk3           Int?
  savedAt        DateTime  @default(now())
  savedDay       String // ngày lưu theo giờ VN
  reviewBox      Int       @default(0) // ôn tập ngắt quãng (sau này)
  dueAt          DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word? @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@unique([userId, zh])
  @@index([userId, savedDay])
}

// Trạng thái ô của từng người.
model UserSlot {
  userId      String    @db.Uuid
  slotId      Int
  hintsOpened Int       @default(0)
  hintGroups  Int[] // nhóm cấp đã dùng khi mở gợi ý 2, 3 (đổi cấp sau đó không đổi gợi ý đã mở)
  foundAt     DateTime?
  points      Int       @default(0)
  early       Boolean   @default(false) // tìm trong tuần của chương (+30)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot KeySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([userId, slotId])
}

// Một dòng cho mỗi người mỗi sự kiện (tháng): lượt, điểm, đoán sai, nhiệm vụ tuần.
model UserEvent {
  userId        String    @db.Uuid
  month         String // "2026-10"
  tokens        Int       @default(0) // lượt gợi ý, hết hạn khi hết tháng
  points        Int       @default(0) // điểm sự kiện (xếp hạng)
  solved        Int       @default(0)
  medal         Int       @default(0) // 0 chưa có, 1 Đồng, 2 Bạc, 3 Vàng, 4 Ngọc
  lastSolvedAt  DateTime? // xếp hạng khi bằng điểm và huy chương
  wrong         Int       @default(0) // tổng số lần sai
  left          Int       @default(3) // lượt đoán còn lại trong nhóm 3
  penalty       Int       @default(0) // điểm phạt chờ trừ vào ô đúng kế tiếp
  lockedUntil   DateTime?
  loginBits     Int       @default(0) // bit (ngày - 1) đã đăng nhập
  joinDay       Int // ngày đăng nhập đầu tiên trong tháng
  lastLoginDay  Int // ngày đăng nhập gần nhất (để tính bù ngày vắng)
  weekLessons   Int[]     @default([0, 0, 0, 0])
  weekOnlineSec Int[]     @default([0, 0, 0, 0])
  weekClaimed   Int[]     @default([0, 0, 0, 0]) // bit mốc tuần đã nhận
  flags         Int       @default(0) // bit: gói theo kịp, VIP mốc cuối...
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
  @@index([month, points(sort: Desc), medal(sort: Desc), lastSolvedAt])
}

// Nhiệm vụ ngày.
model UserMission {
  userId     String    @db.Uuid
  day        String // "2026-10-16" (giờ Việt Nam)
  lessonIds  String[] // bài khác nhau đã nghe + trả lời hết hôm nay
  onlineSec  Int       @default(0)
  lastPingAt DateTime?
  claimed    Int       @default(0) // bit nhiệm vụ đã nhận lượt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// Sổ lượt: chỉ các giao dịch lượt quan trọng (không ghi từng nhiệm vụ nhỏ).
model TokenLedger {
  id        Int       @id @default(autoincrement())
  userId    String    @db.Uuid
  month     String
  delta     Int
  kind      TokenKind
  reason    String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
}

// Túi đồ: bấm mở thì kích hoạt và đếm ngược; không mở thì hết hạn dùng.
model InventoryItem {
  id         Int       @id @default(autoincrement())
  userId     String    @db.Uuid
  kind       ItemKind
  source     String? // "event:2026-10:medal4"
  receivedAt DateTime  @default(now())
  expiresAt  DateTime // hạn mở
  openedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId])
}

// ───────────── Hộp thư ─────────────

// Thư. toUserId null = gửi cho mọi người (chỉ người đã có tài khoản lúc gửi thấy). Có quà khi rewardTokens > 0 hoặc có rewardItem.
model Mail {
  id           Int        @id @default(autoincrement())
  sender       MailSender @default(ADMIN)
  toUserId     String?    @db.Uuid
  subject      String
  body         String
  rewardTokens Int        @default(0)
  rewardItem   ItemKind?
  createdBy    String?    @db.Uuid // quản trị đã gửi
  createdAt    DateTime   @default(now())
  expiresAt    DateTime? // quá hạn thì không nhận quà được nữa

  states UserMail[]

  @@index([toUserId, createdAt])
  @@index([createdAt])
}

// Trạng thái thư của từng người: đã đọc, đã nhận quà, đã xóa.
model UserMail {
  userId    String    @db.Uuid
  mailId    Int
  readAt    DateTime?
  claimedAt DateTime?
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mail Mail @relation(fields: [mailId], references: [id], onDelete: Cascade)

  @@id([userId, mailId])
  @@index([mailId])
}

// ───────────── Ảnh (Cloudflare R2) ─────────────

// Sổ ảnh đã tải lên: để dọn ảnh mồ côi và theo dõi dung lượng. publicId là khóa gốc; mỗi cỡ là file "<khóa>-<cỡ>.webp".
model MediaAsset {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique
  kind      MediaKind
  ownerId   String?   @db.Uuid // người tải lên (null nếu do hệ thống)
  bytes     Int // tổng dung lượng mọi cỡ
  width     Int? // cỡ lớn nhất
  height    Int?
  format    String?
  createdAt DateTime  @default(now())

  @@index([kind])
  @@index([ownerId])
}

// ───────────── Đề nâng cấp ─────────────

// sections: [{ name, questions: [{ id, type: "choice"|"order"|"fill", prompt, options?, answer, points }] }]
model Exam {
  id          String      @id
  standard    HskStandard
  level       Int
  idx         Int
  title       String
  durationMin Int
  maxScore    Int
  passScore   Int
  sections    Json
  published   Boolean     @default(false)

  attempts ExamAttempt[]

  @@unique([standard, level, idx])
}

model ExamAttempt {
  id          Int       @id @default(autoincrement())
  userId      String    @db.Uuid
  examId      String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  passed      Boolean?
  leveledUp   Boolean   @default(false)
  answers     Json? // đáp án người học đã nộp
  detail      Json? // chấm từng câu

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Một lần kiểm tra từ vựng (Sổ tay hoặc bộ từ HSK). Chỉ để người học tự đánh giá, không ảnh hưởng lên cấp.
model VocabTest {
  id          Int       @id @default(autoincrement())
  userId      String    @db.Uuid
  source      String // 'hsk' | 'notebook'
  level       Int? // cấp HSK 2.0 của bộ từ (source = hsk)
  mode        String // 'zh2vi' | 'vi2zh' | 'audio' | 'mix'
  items       Json // [{ zh, mode }] theo thứ tự câu
  setSize     Int // số từ của cả bộ lúc làm (để biết có làm toàn bộ không)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float? // tổng điểm (câu nghe: mỗi phần 0,5)
  pct         Int? // phần trăm điểm
  detail      Json? // chấm từng câu

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level])
}

/// Bài tập viết tự chấm (kỹ năng Viết). `data` giữ đáp án nên không bao giờ gửi nguyên cho người học.
model WritingItem {
  id        Int         @id @default(autoincrement())
  level     Int // cấp HSK 2.0 của bài tập
  type      WritingType
  vi        String // bản dịch tiếng Việt để người học hiểu đề
  data      Json // ORDER: { parts } · FILL: { parts, options, answer } · CHOOSE: { options, answer }
  sort      Int         @default(0)
  grammarId Int? // bài luyện thuộc một điểm ngữ pháp (null = bài tập viết chung)

  grammar GrammarPoint? @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  done    WritingDone[]

  @@index([level, type])
  @@index([grammarId])
}

/// Kết quả gần nhất của người học với một bài tập viết.
model WritingDone {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  itemId    Int
  correct   Boolean
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item WritingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

/// Điểm ngữ pháp (kỹ năng Viết → Ngữ pháp). Bài luyện nằm ở WritingItem.grammarId.
model GrammarPoint {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  level    Int // cấp HSK 2.0; chưa tới cấp này thì khóa
  category String // ví dụ "Câu điều kiện", "Mệnh đề quan hệ"
  title    String
  pattern  String // công thức
  explain  String
  compare  String // so sánh với tiếng Việt/tiếng Anh
  mistake  String // lỗi hay gặp
  examples Json // [{ zh, pinyin, vi }]
  sort     Int    @default(0)

  practice WritingItem[]

  @@index([level, sort])
}

// Mã quà nhập ở Tài khoản. Mỗi người dùng một mã một lần; `maxUses` giới hạn tổng lượt dùng (null = không giới hạn).
model RedeemCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique // viết HOA, không khoảng trắng
  tokens    Int       @default(0) // lượt gợi ý sự kiện tặng thêm
  label     String?
  maxUses   Int?
  used      Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  uses RedeemUse[]
}

model RedeemUse {
  userId String   @db.Uuid
  codeId Int
  usedAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code RedeemCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@id([userId, codeId])
}
