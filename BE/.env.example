# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Supabase "Session pooler" (cổng 5432) dùng được cho cả ứng dụng và migrate.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Chuỗi ngẫu nhiên dài >= 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

PORT=3001
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# Azure Speech (tạo giọng đọc): Portal > tài nguyên Speech > Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Chặn an toàn: script tạo giọng tự dừng khi đã dùng chừng này ký tự Azure trong tháng (gói Free: 500000).
AZURE_SPEECH_MONTHLY_LIMIT=400000
# azure | edge (để trống: dùng Azure nếu đã có AZURE_SPEECH_KEY, không thì edge-tts)
TTS_PROVIDER=

# Cloudflare R2 (chứa âm thanh và ảnh: tiền tố audio/ và img/). Dashboard > R2 > bucket > Settings, và "Manage R2 API Tokens".
S3_ENDPOINT=https://<ma-tai-khoan>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Bật Public Development URL hoặc gắn custom domain cho bucket. FE dùng chuỗi này làm NEXT_PUBLIC_AUDIO_BASE.
S3_PUBLIC_URL=https://pub-<ma>.r2.dev

# ── BẢN DEMO: khi phát hành thật đặt EVENT_OPEN_ALL=false và DEMO_STARTER_TOKENS=0 (hoặc xóa hai dòng này) ──
# Mở sẵn mọi ô từ khóa của mọi chương (không khóa theo ngày/tuần).
EVENT_OPEN_ALL=true
# Số lượt gợi ý tặng khi tạo tài khoản (cả lượt sự kiện lẫn lượt kho lưu trữ).
DEMO_STARTER_TOKENS=999
# Giữ một truyện chạy qua nhiều tháng, không mất tiến độ. Đóng sự kiện: xóa dòng này rồi khởi động lại BE, truyện tự vào kho lưu trữ.
EVENT_PINNED_MONTH=2026-10

# Đặt true khi chạy sau proxy (Render, Vercel) để giới hạn lượt gọi tính theo từng người dùng, không chung một địa chỉ.
TRUST_PROXY=false

# Chấm phát âm (rule.md 3.5). Dùng chung AZURE_SPEECH_KEY và AZURE_SPEECH_REGION ở trên; thiếu khóa thì app ẩn phần này.
# Số lượt mỗi người mỗi ngày.
PRON_DAILY_LIMIT=20
# Chặn an toàn: tổng số giây âm thanh gửi Azure mỗi tháng (mỗi lượt tính gấp đôi). 14400 = 4 giờ, gói Free có 5 giờ.
PRON_MONTHLY_SECONDS=14400
# Số lượt chấm cùng lúc. Gói Free chỉ cho 1; lên gói S0 thì tăng được.
PRON_CONCURRENCY=1
