# Sao chép thành .env.local. FE gọi API cùng nguồn (/api/v1), Next chuyển tiếp sang BE.
NEXT_PUBLIC_API_BASE=/api/v1
# Next chuyển tiếp /api/v1 sang địa chỉ này (chỉ phía máy chủ, không lộ ra trình duyệt).
BE_ORIGIN=http://localhost:3001

# Tên miền CDN của Cloudflare R2 chứa file âm thanh. Để trống thì FE đọc bằng giọng trình duyệt.
NEXT_PUBLIC_AUDIO_BASE=https://pub-xxxxx.r2.dev
